# URLs dos backends locais (Vite). Nenhuma destas variáveis é secreta.
# Validação e leitura em src/config/env.ts (tempo de chamada, não de import).
# O cliente Catalog acrescenta /v1 uma única vez a partir de VITE_CATALOG_URL.
# Health checks da fundação (sem prefixo /v1).
VITE_CATALOG_URL=http://localhost:5101
VITE_BOOKING_URL=http://localhost:5102
VITE_PAYMENT_URL=http://localhost:5103

# API de Booking — Solicitação de Reserva (POST /v1/reservations).
# Distinta da URL de health e da de Catalog; já inclui o prefixo /v1.
# Copie para .env.development (ou .env.local) e ajuste conforme o ambiente.
# Mock local do contrato: VITE_BOOKING_API_URL=http://localhost:4010/v1
VITE_BOOKING_API_URL=http://localhost:5102/v1
