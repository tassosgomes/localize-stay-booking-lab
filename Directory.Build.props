<!-- Este arquivo está na lista de gatilhos do paths-filter do ci.yml para
     TODOS os serviços (catalog/booking/payment/notification-worker): editá-lo
     builda+testa+roda migrate+deploy dos 4, mesmo sem mudança de código de
     serviço. Ver scripts/openmetadata/Directory.Packages.props para o motivo
     de isolar dependências de ferramentas fora deste arquivo raiz.
     Retrigger 2: fix das env vars RabbitMQ dummy no migrate do booking
     (dotnet ef builda o host completo da API e valida RabbitMQ no startup,
     mesmo sem broker envolvido numa migration) — ci.yml sozinho não é
     gatilho do paths-filter. -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- C# 14: versao do compilador do SDK .NET 10 confirmado no repositorio (dotnet 10.0.400). -->
    <LangVersion>14</LangVersion>
  </PropertyGroup>
</Project>
