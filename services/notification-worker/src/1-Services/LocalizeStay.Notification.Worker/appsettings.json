{
  "urls": "http://localhost:5104",
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "VirtualHost": "localize-stay",
    "Source": "/notification-worker",
    "DefaultType": "com.localizestay.diagnostics",
    "MaxAttempts": 5,
    "InitialDelaySeconds": 1,
    "DeliveryLimit": 5,
    "PrefetchCount": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
